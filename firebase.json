{
  "functions": [
    {
      "source": "functions",
      "codebase": "ai-ranking",
      "runtime": "nodejs22"
    },
    {
      "source": "functions-product",
      "codebase": "product-api",
      "runtime": "nodejs22"
    },
    {
      "source": "functions-venue",
      "codebase": "venue-photos",
      "runtime": "nodejs22"
    },
    {
      "source": "functions-recalls",
      "codebase": "food-recalls",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": "build/web",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
